<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>DANA — Klaim Rp40.000 Sekarang</title>
<meta name="description" content="Promo spesial: saldo Rp40.000 untuk 10 pengguna tercepat hari ini.">
<meta name="theme-color" content="#108EE9">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23108EE9'/%3E%3Ctext x='32' y='45' font-family='Arial' font-size='36' font-weight='bold' fill='white' text-anchor='middle'%3ED%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Luckiest+Guy&family=Permanent+Marker&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  :root{
    --blue:#108EE9; --blue-deep:#0A76C4; --blue-soft:#EAF4FE;
    --ink:#10263A; --muted:#61718A; --line:#E3EAF3;
    --bg:#F2F6FB; --gold-soft:#FFF4DC; --warn:#C77800;
    --danger:#E5342B; --yellow:#FFD400; --black:#111;
    --font-app:'Plus Jakarta Sans',sans-serif;
    --font-punch:'Luckiest Guy',cursive;
    --font-hand:'Permanent Marker',cursive;
  }
  html,body{height:100%}
  body{
    font-family:var(--font-app); background:#0B1220; color:var(--ink);
    -webkit-font-smoothing:antialiased; display:flex; justify-content:center;
  }
  /* ===== Bingkai "layar HP" ===== */
  #phone{
    position:relative; width:100%; max-width:430px; background:var(--bg);
    min-height:100dvh; overflow-y:auto; overflow-x:hidden; scrollbar-width:none;
  }
  #phone::-webkit-scrollbar{display:none}
  @media(min-width:520px){
    body{align-items:center; padding:24px}
    #phone{min-height:0; height:min(880px,calc(100dvh - 48px)); border-radius:32px;
      box-shadow:0 30px 80px rgba(0,0,0,.55);}
  }

  .ic{width:18px;height:18px;flex:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

  /* ================= SCENE 1 : PROMO PALSU ================= */
  .appbar{
    background:var(--blue); color:#fff; padding:14px 16px;
    display:flex; align-items:center; gap:10px; position:sticky; top:0; z-index:20;
  }
  .logo{display:flex;align-items:center;gap:8px;font-weight:800;font-size:18px}
  .logo-mark{width:28px;height:28px;border-radius:9px;background:#fff;color:var(--blue);
    display:grid;place-items:center;font-weight:800;font-size:15px}
  .appbar .tag{font-size:10px;font-weight:800;background:rgba(255,255,255,.18);
    padding:4px 9px;border-radius:99px;letter-spacing:.8px;text-transform:uppercase}
  .appbar .spacer{flex:1}
  .icon-btn{background:transparent;border:0;color:#fff;width:32px;height:32px;
    display:grid;place-items:center;cursor:pointer}

  .tape{background:var(--blue-deep);color:#D8ECFD;overflow:hidden;white-space:nowrap;
    font-size:11px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;padding:7px 0}
  .tape span{display:inline-block;animation:tape 16s linear infinite}
  @keyframes tape{to{transform:translateX(-50%)}}

  .main{padding:16px 16px 6px;display:flex;flex-direction:column;gap:13px}
  .card{
    background:#fff;border-radius:20px;padding:18px;border:1px solid var(--line);
    box-shadow:0 2px 10px rgba(16,38,58,.06);animation:up .5s ease both;
  }
  .main>*:nth-child(1){animation-delay:.05s}
  .main>*:nth-child(2){animation-delay:.15s}
  .main>*:nth-child(3){animation-delay:.25s}
  .main>*:nth-child(4){animation-delay:.35s}
  @keyframes up{from{opacity:0;transform:translateY(14px)}}

  .pill{display:inline-flex;align-items:center;gap:6px;background:var(--gold-soft);color:var(--warn);
    font-size:10.5px;font-weight:800;letter-spacing:1px;text-transform:uppercase;
    padding:6px 11px;border-radius:99px;border:1px solid #F0DFAE}
  .pill .ic{width:13px;height:13px}
  .hero h2{font-size:14.5px;font-weight:700;color:var(--muted);margin-top:12px}
  .amount{font-size:52px;font-weight:800;letter-spacing:-1px;color:var(--blue);
    font-variant-numeric:tabular-nums;line-height:1.15;margin:2px 0 6px}
  .hero .lead{font-size:13.5px;color:var(--muted);line-height:1.6}

  .klabel{font-size:10.5px;font-weight:800;letter-spacing:1.3px;text-transform:uppercase;color:var(--muted)}
  .count{display:flex;align-items:center;gap:6px;margin:10px 0 16px}
  .digit{background:var(--ink);color:#fff;font-weight:800;font-size:24px;border-radius:10px;
    min-width:46px;height:44px;display:grid;place-items:center;font-variant-numeric:tabular-nums}
  .digit.hot{background:var(--danger);animation:hot .8s infinite}
  @keyframes hot{50%{background:#B3241C}}
  .count .sep{font-weight:800;font-size:20px;animation:blink 1s steps(2) infinite}
  @keyframes blink{50%{opacity:.25}}

  .slots-row{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px}
  .slots-row b{font-size:14px}
  .seg-bar{display:flex;gap:5px}
  .seg{flex:1;height:10px;border-radius:99px;background:#DCE6F2}
  .seg.on{background:var(--blue)}
  .seg.last{animation:segblink 1s infinite}
  @keyframes segblink{50%{opacity:.3}}
  .slot-note{display:flex;gap:6px;align-items:center;margin-top:10px;font-size:12.5px;
    font-weight:700;color:var(--warn)}
  .slot-note .ic{width:14px;height:14px}

  .live{display:flex;align-items:center;gap:9px;margin-top:15px;padding-top:13px;
    border-top:1px dashed var(--line);font-size:12.5px;font-weight:600;color:var(--muted)}
  .live b{color:var(--ink)}
  .dot{width:8px;height:8px;border-radius:50%;background:#2FBF71;position:relative;flex:none}
  .dot::after{content:"";position:absolute;inset:-4px;border-radius:50%;
    border:2px solid #2FBF71;opacity:.5;animation:ping 1.6s infinite}
  @keyframes ping{to{transform:scale(1.8);opacity:0}}

  .ticker-head{display:flex;align-items:center;gap:8px;margin-bottom:4px}
  .feed{list-style:none}
  .feed li{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--line);animation:slidein .4s ease}
  .feed li:last-child{border-bottom:0;padding-bottom:2px}
  @keyframes slidein{from{opacity:0;transform:translateY(-8px)}}
  .avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;
    color:#fff;font-size:12px;font-weight:800;flex:none}
  .feed .who{flex:1;min-width:0}
  .feed .who b{display:block;font-size:13px}
  .feed .who span{font-size:11.5px;color:var(--muted)}
  .feed .amt{font-size:12.5px;font-weight:800;color:var(--blue)}
  .feed .when{font-size:11px;color:var(--muted)}

  .chips{display:flex;gap:8px;flex-wrap:wrap;animation:up .5s ease .35s both}
  .chip{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:700;
    color:var(--muted);background:#fff;border:1px solid var(--line);border-radius:99px;padding:7px 12px}
  .chip .ic{width:14px;height:14px;color:var(--blue)}

  .foot{padding:4px 18px 14px;font-size:10px;color:#96A5BA;line-height:1.5;text-align:center}

  /* CTA melekat di bawah */
  .cta-wrap{position:sticky;bottom:0;z-index:30;background:rgba(255,255,255,.93);
    backdrop-filter:blur(8px);border-top:1px solid var(--line);
    padding:12px 16px calc(12px + env(safe-area-inset-bottom))}
  .steps{display:none;flex-direction:column;gap:6px;margin-bottom:10px}
  .steps.show{display:flex}
  .step{display:flex;align-items:center;gap:9px;font-size:12.5px;font-weight:600;
    color:var(--muted);background:var(--blue-soft);border-radius:10px;padding:8px 11px;animation:slidein .3s ease}
  .step.done{color:#18794D;background:#E8F7EF}
  .step.fail{color:var(--danger);background:#FDECEA;font-weight:700;animation:shiver .3s}
  @keyframes shiver{25%{transform:translateX(-3px)}75%{transform:translateX(3px)}}
  .step .st{width:16px;height:16px;flex:none;display:grid;place-items:center}
  .step .ic{width:15px;height:15px}
  .spinner{width:14px;height:14px;border-radius:50%;border:2px solid rgba(16,142,233,.25);
    border-top-color:var(--blue);animation:spin .7s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}

  .btn-cta{position:relative;overflow:hidden;width:100%;border:0;background:var(--blue);
    color:#fff;font-family:var(--font-app);font-weight:800;font-size:16px;letter-spacing:.4px;
    padding:16px;border-radius:16px;cursor:pointer;display:flex;align-items:center;
    justify-content:center;gap:10px;transition:transform .12s;
    box-shadow:0 8px 20px rgba(16,142,233,.35);animation:pulse 2s infinite}
  .btn-cta:active{transform:scale(.965)}
  .btn-cta:disabled{animation:none;cursor:default}
  @keyframes pulse{
    0%{box-shadow:0 8px 20px rgba(16,142,233,.35),0 0 0 0 rgba(16,142,233,.4)}
    70%{box-shadow:0 8px 20px rgba(16,142,233,.35),0 0 0 16px rgba(16,142,233,0)}
    100%{box-shadow:0 8px 20px rgba(16,142,233,.35),0 0 0 0 rgba(16,142,233,0)}
  }
  .btn-cta .sheen{position:absolute;top:0;bottom:0;left:-70%;width:45%;
    background:rgba(255,255,255,.28);transform:skewX(-22deg);animation:sheen 3.2s ease-in-out infinite;pointer-events:none}
  @keyframes sheen{0%,60%{left:-70%}95%,100%{left:135%}}
  .btn-cta:disabled .sheen{display:none}
  .btn-cta .chev{animation:nudge 1.2s infinite}
  @keyframes nudge{50%{transform:translateX(4px)}}
  .micro{font-size:10px;color:var(--muted);text-align:center;margin-top:8px}

  /* ================= SCENE 2 : PRANK! ================= */
  #scenePromo{display:block}
  body.pranked #scenePromo{display:none}
  #scenePrank{display:none}
  body.pranked #scenePrank{
    display:flex;min-height:100dvh;position:relative;overflow:hidden;
    flex-direction:column;align-items:center;justify-content:center;text-align:center;
    padding:40px 20px;color:var(--black);
    background:var(--yellow);
    background-image:radial-gradient(rgba(0,0,0,.07) 1.2px,transparent 1.2px);
    background-size:16px 16px;
  }
  .prank-inner{display:flex;flex-direction:column;align-items:center;width:100%}

  .eyebrow{background:var(--black);color:var(--yellow);font-weight:800;font-size:11px;
    letter-spacing:1.6px;text-transform:uppercase;padding:9px 15px;border-radius:99px;
    transform:rotate(-2deg);animation:pop .5s cubic-bezier(.2,1.6,.4,1) .1s both}
  .hiya{font-family:var(--font-punch);font-size:clamp(42px,11.5vw,66px);line-height:.92;
    margin:18px 0 4px;text-transform:uppercase;
    animation:pop .55s cubic-bezier(.2,1.6,.4,1) .22s both}
  .hiya em{font-style:normal;color:var(--danger);text-shadow:3px 3px 0 var(--black)}
  @keyframes pop{from{opacity:0;transform:scale(.4) rotate(-5deg)}}

  .polaroid{position:relative;background:#fff;padding:12px 12px 14px;border-radius:6px;
    box-shadow:0 18px 40px rgba(0,0,0,.28);transform:rotate(-3deg);margin:24px 0 12px;
    animation:slam .6s cubic-bezier(.2,1.4,.3,1) .38s both;cursor:pointer;
    -webkit-tap-highlight-color:transparent}
  @keyframes slam{
    from{opacity:0;transform:rotate(6deg) scale(.35)}
    60%{transform:rotate(-4deg) scale(1.05)}
    to{transform:rotate(-3deg) scale(1)}
  }
  .polaroid.wiggle{animation:wiggle .5s ease}
  @keyframes wiggle{
    20%{transform:rotate(-7deg) scale(1.05)}
    45%{transform:rotate(1deg) scale(1.02)}
    70%{transform:rotate(-5deg) scale(1)}
  }
  .polaroid img{display:block;width:min(72vw,300px);aspect-ratio:1/1;object-fit:cover;
    border-radius:3px;background:#EDEDED}
  .polaroid .cap{font-family:var(--font-hand);font-size:17px;margin-top:10px;color:#222}
  .tape-strip{position:absolute;width:86px;height:24px;background:rgba(255,255,255,.6);
    border:1px solid rgba(0,0,0,.05);top:-11px;box-shadow:0 2px 5px rgba(0,0,0,.14)}
  .tape-strip.l{left:-26px;transform:rotate(-38deg)}
  .tape-strip.r{right:-26px;transform:rotate(38deg)}
  .stamp{position:absolute;top:-18px;right:-16px;transform:rotate(12deg);
    font-family:var(--font-punch);font-size:21px;letter-spacing:1px;color:var(--danger);
    border:4px solid var(--danger);border-radius:8px;padding:4px 11px;
    background:rgba(255,255,255,.78);
    animation:stampin .45s cubic-bezier(.3,2,.4,1) 1.05s both}
  @keyframes stampin{from{opacity:0;transform:rotate(12deg) scale(2.6)}}
  .heart{position:absolute;pointer-events:none;z-index:5;animation:floatup .9s ease-out forwards}
  .heart .ic{width:22px;height:22px;fill:currentColor;stroke:none;color:var(--danger)}
  @keyframes floatup{
    from{opacity:1;transform:translateY(0) scale(.6)}
    to{opacity:0;transform:translateY(-90px) scale(1.3) rotate(-14deg)}
  }

  .sub{max-width:310px;font-size:13.5px;font-weight:600;line-height:1.55;
    color:rgba(0,0,0,.75);animation:rise .5s ease .6s both}
  @keyframes rise{from{opacity:0;transform:translateY(10px)}}

  .actions{display:flex;gap:10px;margin-top:24px;flex-wrap:wrap;justify-content:center;
    animation:rise .5s ease .75s both}
  .btn-dark,.btn-ghost{
    font-family:var(--font-app);font-weight:800;font-size:14px;letter-spacing:.3px;
    padding:14px 20px;border-radius:99px;cursor:pointer;display:inline-flex;
    align-items:center;gap:8px;border:3px solid var(--black);
    transition:transform .1s,box-shadow .1s;box-shadow:4px 4px 0 var(--black);
  }
  .btn-dark{background:var(--black);color:#fff}
  .btn-dark .ic{color:var(--yellow)}
  .btn-ghost{background:transparent;color:var(--black)}
  .btn-dark:active,.btn-ghost:active{transform:translate(3px,3px);box-shadow:1px 1px 0 var(--black)}
  .tapline{margin-top:22px;font-size:12.5px;font-weight:700;color:rgba(0,0,0,.62);
    background:rgba(255,255,255,.55);border:2px solid rgba(0,0,0,.14);border-radius:99px;
    padding:7px 15px;animation:rise .5s ease .85s both}

  /* Hujan monyet */
  #rain{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:4}
  .drop{position:absolute;top:-80px;border-radius:50%;overflow:hidden;
    border:3px solid #fff;box-shadow:0 6px 14px rgba(0,0,0,.25);
    animation:fall var(--dur) ease-in var(--delay) forwards}
  .drop img{width:100%;height:100%;object-fit:cover;display:block}
  @keyframes fall{
    0%{transform:translate3d(0,-10vh,0) rotate(0deg);opacity:0}
    6%{opacity:1}
    100%{transform:translate3d(var(--dx),115vh,0) rotate(var(--spin));opacity:1}
  }

  /* Efek global */
  #flash{position:fixed;inset:0;background:#fff;opacity:0;pointer-events:none;z-index:99}
  #flash.go{animation:flashy .5s ease-out}
  @keyframes flashy{0%{opacity:1}100%{opacity:0}}
  #phone.shake{animation:shake .55s}
  @keyframes shake{
    10%,90%{transform:translate(-2px,1px)}
    20%,80%{transform:translate(4px,-2px)}
    30%,70%{transform:translate(-6px,2px)}
    40%,60%{transform:translate(5px,-1px)}
    50%{transform:translate(-4px,2px)}
  }
  #toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);
    background:var(--ink);color:#fff;font-size:13px;font-weight:600;padding:12px 18px;
    border-radius:99px;opacity:0;pointer-events:none;transition:.3s;z-index:120;
    display:flex;gap:8px;align-items:center;max-width:88vw}
  #toast .ic{width:16px;height:16px;color:#4ADE80}
  #toast.show{opacity:1;transform:translate(-50%,0)}
  #sndBtn{position:fixed;right:14px;bottom:14px;z-index:110;width:42px;height:42px;
    border-radius:50%;background:#fff;border:1px solid var(--line);cursor:pointer;
    box-shadow:0 4px 14px rgba(0,0,0,.2);display:grid;place-items:center;color:var(--ink)}
</style>
</head>
<body>

<!-- Sprite ikon (SVG inline, tanpa emoji) -->
