</svg>

<div id="phone">

  <!-- ============ SCENE 1 : PROMO PALSU ============ -->
  <section id="scenePromo">
    <header class="appbar">
      <div class="logo"><span class="logo-mark">D</span>DANA</div>
      <span class="tag">Promo</span>
      <span class="spacer"></span>
      <button class="icon-btn" aria-label="Menu"><svg class="ic"><use href="#i-dots"/></svg></button>
    </header>

    <div class="tape">
      <span>Flash sale grup &middot; Rp40.000 untuk 10 orang tercepat &middot; Setiap jam &middot; Flash sale grup &middot; Rp40.000 untuk 10 orang tercepat &middot; Setiap jam &middot; </span>
    </div>

    <div class="main">
      <section class="card hero">
        <span class="pill"><svg class="ic"><use href="#i-zap"/></svg>Promo grup tercepat</span>
        <h2>Kamu terpilih untuk menerima</h2>
        <div class="amount" id="amount">Rp0</div>
        <p class="lead">Saldo langsung masuk ke dompet DANA-mu untuk <b>10 pengguna tercepat</b> pada periode klaim jam ini.</p>
      </section>

      <section class="card">
        <span class="klabel">Berakhir dalam</span>
        <div class="count">
          <div class="digit" id="mm">05</div><span class="sep">:</span><div class="digit" id="ss">00</div>
        </div>
        <div class="slots-row">
          <span class="klabel">Slot terklaim</span>
          <b id="slotCount">7/10</b>
        </div>
        <div class="seg-bar" id="segs"></div>
        <p class="slot-note"><svg class="ic"><use href="#i-zap"/></svg><span id="slotLeft"></span></p>
        <div class="live">
          <span class="dot"></span>
          <span><b id="viewers">1.247</b> orang sedang melihat halaman ini</span>
        </div>
      </section>

      <section class="card">
        <div class="ticker-head">
          <span class="klabel"><svg class="ic" style="width:13px;height:13px;vertical-align:-2px"><use href="#i-eye"/></svg> Aktivitas klaim</span>
          <span class="dot" style="margin-left:auto"></span>
        </div>
        <ul class="feed" id="feed"></ul>
      </section>

      <div class="chips">
        <span class="chip"><svg class="ic"><use href="#i-shield"/></svg>Terverifikasi</span>
        <span class="chip"><svg class="ic"><use href="#i-zap"/></svg>Instan</span>
        <span class="chip"><svg class="ic"><use href="#i-lock"/></svg>Aman</span>
      </div>
    </div>

    
    <div class="cta-wrap">
      <div class="steps" id="steps"></div>
      <button class="btn-cta" id="cta">
        <span class="sheen"></span>
        <svg class="ic" style="width:20px;height:20px"><use href="#i-gift"/></svg>
        <span id="ctaLabel">BUKA HADIAH SEKARANG</span>
        <svg class="ic chev" style="width:20px;height:20px"><use href="#i-chev"/></svg>
      </button>
      <p class="micro">*Gratis, tanpa login. Hadiah berupa apa pun yang muncul di layar.</p>
    </div>
  </section>

  <!-- ============ SCENE 2 : PRANK! ============ -->
  <section id="scenePrank">
    <div id="rain"></div>
    <div class="prank-inner">
      <span class="eyebrow">Selamat, kamu dapat hadiah</span>
      <h1 class="hiya">SATU EKOR<br><em>MONYET</em></h1>

      <figure class="polaroid" id="polaroid">
        <span class="tape-strip l"></span><span class="tape-strip r"></span>
        <span class="stamp">KEPRANK!</span>
        <img id="monkeyImg" alt="Monyet tersenyum — hadiahmu">
        <figcaption class="cap">hadiah spesial buat kamu</figcaption>
      </figure>

      <p class="sub">Hadiah Rp40.000 tadi larinya kencang banget — diambil 10 monyet tercepat. Tapi tenang, kamu dapat yang paling ganteng.</p>

      <div class="actions">
        <button class="btn-dark" id="btnShare"><svg class="ic"><use href="#i-share"/></svg>PRANK TEMANMU JUGA</button>
        <button class="btn-ghost" id="btnAgain"><svg class="ic"><use href="#i-refresh"/></svg>ULANGI</button>
      </div>

      <p class="tapline" id="tapMsg">Ketuk foto monyetnya — dia suka diperhatikan.</p>
    </div>
  </section>
</div>

<div id="flash"></div>
<div id="toast"><svg class="ic"><use href="#i-check"/></svg><span></span></div>
<button id="sndBtn" aria-label="Suara"><svg class="ic"><use href="#i-vol"/></svg></button>

<script>
/* ================== KONFIGURASI GAMBAR MONYET ================== */
const MONKEY_SRC = 'https://z-cdn-media.chatglm.cn/files/3fb230c2-2e84-4400-9fc9-5d73e538bd35.jpg?auth_key=1888066595-8d328ad29b684898a77520d567ddb75a-0-072f1696a1f986fa92c207af2c0e8821';

// Fallback: kalau link monyet kedaluwarsa, pakai monyet kartun SVG biar prank tetap jalan
const FALLBACK_SVG = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'>
<rect width='200' height='200' fill='#f7e9d0'/>
<circle cx='52' cy='70' r='26' fill='%238d6748'/><circle cx='148' cy='70' r='26' fill='%238d6748'/>
<circle cx='52' cy='70' r='14' fill='%23d9b38c'/><circle cx='148' cy='70' r='14' fill='%23d9b38c'/>
<ellipse cx='100' cy='105' rx='52' ry='46' fill='%238d6748'/><ellipse cx='100' cy='115' rx='34' ry='30' fill='%23d9b38c'/>
<circle cx='84' cy='92' r='7' fill='%23222'/><circle cx='116' cy='92' r='7' fill='%23222'/>
<circle cx='86' cy='89' r='2.4' fill='white'/><circle cx='118' cy='89' r='2.4' fill='white'/>
<ellipse cx='100' cy='110' rx='8' ry='5' fill='%23301f14'/>
<path d='M82 124 Q100 140 118 124' stroke='%23301f14' stroke-width='4' fill='none' stroke-linecap='round'/>
</svg>`;
const FALLBACK_SRC = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(FALLBACK_SVG.replace(/%23/g, '#'));

let monkeySrc = MONKEY_SRC;
const monkeyImg = document.getElementById('monkeyImg');
monkeyImg.src = MONKEY_SRC;
monkeyImg.onerror = () => { if (monkeyImg.src !== FALLBACK_SRC) { monkeySrc = FALLBACK_SRC; monkeyImg.src = FALLBACK_SRC; } };

/* ================== AUDIO (Web Audio API, tanpa file) ================== */
let actx = null, master = null, muted = false;
function ac(){
  if (!actx) {
    actx = new (window.AudioContext || window.webkitAudioContext)();
    master = actx.createGain(); master.gain.value = .9; master.connect(actx.destination);
  }
  if (actx.state === 'suspended') actx.resume();
  return actx;
}
function beep(f=880, d=.08, type='sine', v=.13){
  if (muted) return;
  const c = ac(), t = c.currentTime, o = c.createOscillator(), g = c.createGain();
  o.type = type; o.frequency.value = f;
  g.gain.setValueAtTime(1e-4, t);
  g.gain.exponentialRampToValueAtTime(v, t + .012);
  g.gain.exponentialRampToValueAtTime(1e-4, t + d);
  o.connect(g); g.connect(master); o.start(t); o.stop(t + d + .02);
}
function buzz(){
  if (muted) return;
  const c = ac(), t = c.currentTime, o = c.createOscillator(), g = c.createGain();
  o.type = 'sawtooth';
  o.frequency.setValueAtTime(140, t);
  o.frequency.exponentialRampToValueAtTime(70, t + .3);
  g.gain.setValueAtTime(.18, t);
  g.gain.exponentialRampToValueAtTime(1e-4, t + .32);
  o.connect(g); g.connect(master); o.start(t); o.stop(t + .35);
}
// Trombone sedih: 4 nada turun, nada terakhir panjang + vibrato
function sadTrombone(){
  if (muted) return;
  const c = ac();
  const notes = [[233.08,.32],[220,.32],[207.65,.32],[196,1.15]];
  let time = c.currentTime + .05;
  notes.forEach(([f, d], i) => {
    const o = c.createOscillator(); o.type = 'sawtooth';
    const g = c.createGain();
    const lp = c.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 1100; lp.Q.value = 3;
    const lfo = c.createOscillator(); lfo.frequency.value = 6.2;
    const lfoG = c.createGain(); lfoG.gain.value = (i === notes.length - 1) ? 9 : 3;
    lfo.connect(lfoG); lfoG.connect(o.frequency);
    o.frequency.setValueAtTime(f, time);
    if (i === notes.length - 1) o.frequency.linearRampToValueAtTime(f * .93, time + d);
    g.gain.setValueAtTime(1e-4, time);
    g.gain.exponentialRampToValueAtTime(.2, time + .04);
    g.gain.setValueAtTime(.2, time + d * .7);
    g.gain.exponentialRampToValueAtTime(1e-4, time + d);
    o.connect(lp); lp.connect(g); g.connect(master);
    o.start(time); lfo.start(time);
    o.stop(time + d + .05); lfo.stop(time + d + .05);
    time += d + .03;
  });
}
// Suara monyet: "ook" (sweep turun, kadang dua kali)
function ook(){
  if (muted) return;
  const c = ac(); let t = c.currentTime + .02;
  const n = 1 + (Math.random() * 2 | 0);
  for (let i = 0; i < n; i++) {
    const o = c.createOscillator(), g = c.createGain(), f = c.createBiquadFilter();
    f.type = 'lowpass'; f.frequency.value = 1500;
    o.type = 'sawtooth';
    const f0 = 420 + Math.random() * 120;
    o.frequency.setValueAtTime(f0, t);
    o.frequency.exponentialRampToValueAtTime(f0 * .45, t + .16);
    g.gain.setValueAtTime(1e-4, t);
    g.gain.exponentialRampToValueAtTime(.15, t + .02);
    g.gain.exponentialRampToValueAtTime(1e-4, t + .18);
    o.connect(f); f.connect(g); g.connect(master);
    o.start(t); o.stop(t + .2); t += .19;
  }
}

/* ================== TOAST ================== */
let toastTimer;
function toast(msg){
  const t = document.getElementById('toast');
  t.querySelector('span').textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2600);
}

/* ================== SCENE PROMO: angka hidup ================== */
// Count-up Rp40.000
(function(){
  const el = document.getElementById('amount');
  const target = 40000, dur = 1400, t0 = performance.now();
  (function step(t){
    const p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3);
    el.textContent = 'Rp' + Math.round(target * e).toLocaleString('id-ID');
    if (p < 1) requestAnimationFrame(step);
  })(t0);
})();

// Countdown periode klaim
let remain = 299;
const mm = document.getElementById('mm'), ss = document.getElementById('ss');
function renderCd(){
  mm.textContent = String(Math.floor(remain / 60)).padStart(2, '0');
  ss.textContent = String(remain % 60).padStart(2, '0');
  const hot = remain <= 30;
  mm.classList.toggle('hot', hot); ss.classList.toggle('hot', hot);
}
setInterval(() => { remain--; if (remain < 0) remain = 299; renderCd(); }, 1000);
renderCd();

// Slot 10 orang tercepat (bergeser pelan-pelan sampai sisa 1)
let filled = 7; const SLOT_TOTAL = 10;
const segs = document.getElementById('segs');
function renderSlots(){
  segs.innerHTML = '';
  for (let i = 0; i < SLOT_TOTAL; i++) {
    const d = document.createElement('div');
    d.className = 'seg' + (i < filled ? ' on' : '') + (i === filled ? ' last' : '');
    segs.appendChild(d);
  }
  document.getElementById('slotCount').textContent = filled + '/' + SLOT_TOTAL;
  const left = SLOT_TOTAL - filled;
  document.getElementById('slotLeft').textContent =
    left === 1 ? 'Sisa 1 slot — yang terakhir!' : `Sisa ${left} slot — jangan sampai kehabisan!`;
}
renderSlots();
(function scheduleFill(){
  setTimeout(() => {
    if (filled < 9 && !document.body.classList.contains('pranked')) { filled++; renderSlots(); addFeed(); }
    scheduleFill();
  }, 28000 + Math.random() * 26000);
})();

// Penonton "live" yang berfluktuasi
let viewers = 1200 + (Math.random() * 400 | 0);
const viewersEl = document.getElementById('viewers');
setInterval(() => {
  viewers = Math.max(900, viewers + (Math.random() * 25 | 0) - 10);
  viewersEl.textContent = viewers.toLocaleString('id-ID');
}, 2600);
viewersEl.textContent = viewers.toLocaleString('id-ID');

// Feed klaim palsu
const FIRST = ['Andi','Budi','Citra','Dewi','Eko','Fitri','Gilang','Hana','Indra','Joko','Kiki','Lina','Maya','Nanda','Oki','Putri','Rizky','Sari','Tono','Vina','Wawan','Yuni','Zaki'];
const LAST = ['S.','P.','R.','M.','K.','H.','N.','W.','A.','D.'];
const CITY = ['Jakarta','Bandung','Surabaya','Medan','Makassar','Semarang','Palembang','Denpasar','Yogyakarta','Bogor','Tangerang','Bekasi','Malang','Depok'];
const AV_COLORS = ['#108EE9','#00A8A8','#F5713D','#7C5CE0','#E0566F'];
const feed = document.getElementById('feed');
function addFeed(customName){
  const li = document.createElement('li');
  const name = customName || (FIRST[Math.random() * FIRST.length | 0] + ' ' + LAST[Math.random() * LAST.length | 0]);
  const initials = name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
  li.innerHTML =
    `<span class="avatar" style="background:${AV_COLORS[Math.random() * AV_COLORS.length | 0]}">${initials}</span>` +
    `<span class="who"><b>${name}</b><span>${CITY[Math.random() * CITY.length | 0]}</span></span>` +
    `<span class="amt">+Rp40.000</span>` +
    `<span class="when" data-ts="${Date.now()}">baru saja</span>`;
  feed.prepend(li);
  while (feed.children.length > 5) feed.lastElementChild.remove();
}
addFeed('Dita R.'); addFeed('Bagas P.'); addFeed('Nadia S.');
setInterval(() => { if (!document.body.classList.contains('pranked')) addFeed(); }, 5200);
setInterval(() => {
  document.querySelectorAll('#feed .when').forEach(w => {
    const dt = Math.floor((Date.now() - +w.dataset.ts) / 60000);
    w.textContent = dt < 1 ? 'baru saja' : dt + ' mnt';
  });
}, 20000);

/* ================== KLIK TOMBOL: VERIFIKASI PALSU → REVEAL ================== */
const cta = document.getElementById('cta');
const ctaLabel = document.getElementById('ctaLabel');
const steps = document.getElementById('steps');
let busy = false;

function mkStep(txt){
  const d = document.createElement('div');
  d.className = 'step';
  d.innerHTML = `<span class="st"><span class="spinner"></span></span><span class="lbl">${txt}</span>`;
  steps.appendChild(d);
  return d;
}
function okStep(el){
  el.classList.add('done');
  el.querySelector('.st').innerHTML = '<svg class="ic"><use href="#i-check"/></svg>';
  beep(740 + Math.random() * 90, .09);
}
function failStep(el, txt){
  el.classList.add('fail');
  el.querySelector('.st').innerHTML = '<svg class="ic"><use href="#i-alert"/></svg>';
  el.querySelector('.lbl').textContent = txt;
  buzz();
}

cta.addEventListener('click', () => {
  if (busy) return;
  busy = true;
  ac(); // aktifkan audio dari gesture pengguna
  cta.disabled = true;
  ctaLabel.textContent = 'MEMPROSES HADIAH…';
  steps.classList.add('show');
  beep(600, .07);

  const s1 = mkStep('Memverifikasi perangkat…');
  setTimeout(() => {
    okStep(s1);
    const s2 = mkStep('Menghubungi server DANA…');
    setTimeout(() => {
      okStep(s2);
      const s3 = mkStep('Menyiapkan saldo Rp40.000…');
      setTimeout(() => {
        okStep(s3);
        const s4 = mkStep('Mengambil hadiah dari gudang…');
        setTimeout(() => {
          failStep(s4, 'GAGAL: hadiah sedang dikunyah.');
          ctaLabel.textContent = 'TUNGGU…';
          setTimeout(reveal, 750);
        }, 1200);
      }, 600);
    }, 600);
  }, 500);
});

function reveal(){
  document.body.classList.add('pranked');
  document.title = 'KEPRANK!';
  const flash = document.getElementById('flash');
  flash.classList.add('go');
  setTimeout(() => flash.classList.remove('go'), 600);
  const phone = document.getElementById('phone');
  phone.classList.add('shake');
  setTimeout(() => phone.classList.remove('shake'), 600);
  phone.scrollTop = 0;
  sadTrombone();
  startRain();
}

/* ================== HUJAN MONYET ================== */
let rainTimers = [];
function spawnDrop(xPx){
  const rain = document.getElementById('rain');
  const w = rain.clientWidth || 400;
  const d = document.createElement('div');
  d.className = 'drop';
  const size = 34 + Math.random() * 34;
  d.style.width = d.style.height = size + 'px';
  d.style.left = (xPx !== undefined ? xPx - size / 2 : Math.random() * (w - size)) + 'px';
  d.style.setProperty('--dx', (Math.random() * 120 - 60) + 'px');
  d.style.setProperty('--spin', (Math.random() * 520 - 260) + 'deg');
  d.style.setProperty('--dur', (2.1 + Math.random() * 1.6) + 's');
  d.style.setProperty('--delay', (Math.random() * .5) + 's');
  const im = document.createElement('img');
  im.src = monkeySrc; im.alt = '';
  d.appendChild(im);
  rain.appendChild(d);
  d.addEventListener('animationend', () => d.remove());
}
function startRain(){
  stopRain();
  for (let w = 0; w < 5; w++) {
    rainTimers.push(setTimeout(() => {
      for (let i = 0; i < 12; i++) spawnDrop();
    }, w * 1300));
  }
}
function stopRain(){
  rainTimers.forEach(clearTimeout); rainTimers = [];
  document.getElementById('rain').innerHTML = '';
}

// Ketuk latar kuning = monyet jatuh dari langit di titik itu
document.getElementById('scenePrank').addEventListener('click', e => {
  if (e.target.closest('button, .polaroid')) return;
  const rect = e.currentTarget.getBoundingClientRect();
  spawnDrop(e.clientX - rect.left);
});

/* ================== MONYET BISA DIKETUK ================== */
const polaroid = document.getElementById('polaroid');
const tapMsg = document.getElementById('tapMsg');
let taps = 0;
const TAP_LINES = {
  1: 'Monyet tersipu malu.',
  3: 'Monyet mulai curiga.',
  6: 'Monyet menatapmu balik.',
  10: 'Ook. Ook ook.',
  15: 'Monyet mempertimbangkan memaafkanmu.',
  20: 'Kalian resmi jadi sahabat.',
  30: 'Monyet minta dibuatkan akun DANA.'
};
polaroid.addEventListener('click', e => {
  e.stopPropagation();
  taps++; ook();
  polaroid.classList.remove('wiggle');
  void polaroid.offsetWidth; // restart animasi
  polaroid.classList.add('wiggle');
  for (let i = 0; i < 2; i++) {
    const h = document.createElement('span');
    h.className = 'heart';
    h.style.left = (20 + Math.random() * 60) + '%';
    h.style.top = (25 + Math.random() * 45) + '%';
    h.innerHTML = '<svg class="ic"><use href="#i-heart"/></svg>';
    polaroid.appendChild(h);
    setTimeout(() => h.remove(), 950);
  }
  tapMsg.textContent = TAP_LINES[taps] || `Diketuk ${taps}\u00d7 — monyet ini sabar luar biasa.`;
});

/* ================== TOMBOL AKSI PRANK ================== */
document.getElementById('btnShare').addEventListener('click', async () => {
  ook();
  const url = location.href;
  try {
    await navigator.clipboard.writeText(url);
    toast('Link tersalin — kirim ke korban berikutnya!');
  } catch {
    const ta = document.createElement('textarea');
    ta.value = url; document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); toast('Link tersalin — kirim ke korban berikutnya!'); }
    catch { toast('Salin linknya dari address bar ya.'); }
    ta.remove();
  }
});

document.getElementById('btnAgain').addEventListener('click', () => {
  document.body.classList.remove('pranked');
  document.title = 'DANA — Klaim Rp40.000 Sekarang';
  stopRain();
  steps.classList.remove('show'); steps.innerHTML = '';
  cta.disabled = false; busy = false;
  ctaLabel.textContent = 'BUKA HADIAH SEKARANG';
  document.getElementById('phone').scrollTop = 0;
  toast('Prank direset. Gaskeun lagi!');
});

/* ================== TOGGLE SUARA ================== */
const sndBtn = document.getElementById('sndBtn');
sndBtn.addEventListener('click', () => {
  muted = !muted;
  sndBtn.innerHTML = `<svg class="ic"><use href="#${muted ? 'i-volx' : 'i-vol'}"/></svg>`;
  if (!muted) beep(880, .07);
});
</script>
